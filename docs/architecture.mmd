flowchart TB
    subgraph Inputs
        M[Meeting notes]
        D[Requirement text or PDF]
        B[Existing backlog JSON]
    end

    subgraph Loaders["Deterministic loaders"]
        L[Document Loader]
        BL[Backlog Loader]
    end

    subgraph Tools["Controlled tools"]
        RI[Request Inspection Tool]
        SR[Source Reader Tool]
        BS[Backlog Search Tool]
        SC[Story Context Tool]
        PV[Proposal Validation Tool]
    end

    subgraph AI["AI agent layer - Microsoft Agent Framework"]
        O["Orchestrator Agent<br/>[AI Model]"]
        R["Requirements Analyst Agent<br/>[AI Model]"]
        A["Backlog Analyst Agent<br/>[AI Model]"]
        S["Story Writer Agent<br/>[AI Model]"]
        Q["Quality Reviewer Agent<br/>[AI Model]"]
    end

    subgraph Outputs
        J[Structured JSON proposal]
        MD[Readable Markdown proposal]
        H[Human review]
        LOG[Rotating runtime log]
    end

    M --> L
    D --> L
    B --> BL
    L --> O
    BL --> O

    O -- "WorkPlan\n· source_type · stages[]" --> R
    R -- "RequirementAnalysis\n· requirements[id, statement, source_locations[]]\n· assumptions[]" --> A
    A -- "BacklogAnalysis\n· matches[req_id, backlog_id, relationship, action]\n· gap_requirement_ids[]" --> S
    S -- "StoryDraft\n· stories[id, title, acceptance_criteria[]\n  requirement_ids[], recommended_action]" --> Q

    O -. "source_type · backlog_item_count" .-> RI
    RI -. "RequestInspectionOutput\n· request_classification · valid_source\n· required_stages[] · warnings[]" .-> O
    R -. "source: str · source_type" .-> SR
    SR -. "SourceReaderOutput\n· sections[section_id, section_text, location]\n· content_complete" .-> R
    A -. "requirements[id, statement]\n· BacklogItem[id, title, description]" .-> BS
    BS -. "BacklogSearchOutput\n· candidates[req_id, backlog_id, relevance_score]\n· no_match_requirement_ids[]" .-> A
    S -. "requirements[id, statement, priority, category]\n· matches[req_id, backlog_id]" .-> SC
    SC -. "StoryContextOutput\n· requirement_contexts[\n  req_id, statement, priority,\n  category, related_backlog_items[]]" .-> S
    Q -. "requirements · analysis[matches]\n· draft[stories] · backlog[id]" .-> PV
    PV -. "ProposalValidationResult\n· overall_result: passed|failed\n· findings[severity, category]\n· valid_story_count" .-> Q

    PV --> J
    PV -. workflow events .-> LOG
    J --> MD
    J --> H
    MD --> H
